#!/usr/bin/env python3
"""Frida launcher — keeps the package importable however it was installed."""
import os
import sys

_here = os.path.dirname(os.path.abspath(__file__))
for candidate in (os.path.dirname(_here),
                  os.path.expanduser("~/.local/share/frida")):
    if os.path.isdir(os.path.join(candidate, "frida")):
        if candidate not in sys.path:
            sys.path.insert(0, candidate)
        break

from frida.main import run  # noqa: E402

if __name__ == "__main__":
    run()
